# Use Node.js LTS version
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port for development
EXPOSE 5173

# Start development server with host flag to allow external access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"] 